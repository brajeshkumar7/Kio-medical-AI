NEXT_PUBLIC_API_URL=http://localhost:8080
# Vercel builds need the deployed HTTPS backend URL instead of localhost.
# vercel.app staging uses development keys. Production Clerk requires a custom domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# Never prefix this secret with NEXT_PUBLIC_ or put backend/Blob credentials here.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
