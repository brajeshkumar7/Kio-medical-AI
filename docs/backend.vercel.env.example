# Backend Vercel project only. Import filled values into the Production scope
# for the initial vercel.app staging release. Never commit a filled copy.
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@POOLER_HOST:PORT/DATABASE?sslmode=require
DATABASE_POOL_MODE=null
CLERK_ISSUER_URL=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev
GUEST_IP_HASH_SECRET=YOUR_STABLE_RANDOM_STAGING_SECRET
FRONTEND_ORIGIN=https://YOUR_WEB_PROJECT.vercel.app
CLERK_AUTHORIZED_PARTIES=https://YOUR_WEB_PROJECT.vercel.app
TRUSTED_PROXY_HOPS=1
FLASK_DEBUG=false

# Non-secret model, index and retrieval values match the current local settings.
# Preserve the populated index and its matching embedding model.
PINECONE_INDEX_NAME=medicalbot-openai-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-6-luna-pro
OPENROUTER_REVIEW_MODEL=openai/gpt-6-luna-pro
OPENROUTER_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
RETRIEVAL_K=6
RETRIEVAL_FETCH_K=16
RETRIEVAL_LAMBDA_MULT=0.65
RETRIEVAL_LEXICAL_K=4
RETRIEVAL_CONTEXT_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
ANSWER_MAX_TOKENS=1800
ANSWER_REVIEW_ENABLED=true
HISTORY_MESSAGE_LIMIT=12

# Populate after exporting the cache and uploading it to Vercel Private Blob.
LEXICAL_CACHE_PATH=backend/_artifacts/lexical-cache.json.gz
LEXICAL_CACHE_ARTIFACT_URL=https://YOUR_STORE.private.blob.vercel-storage.com/lexical/v1/lexical-v1.json.gz
LEXICAL_CACHE_ARTIFACT_SHA256=YOUR_COMPRESSED_ARTIFACT_SHA256
BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_BLOB_STORE_TOKEN
