# Frontend Vercel project only. Import filled values into the Production scope
# for the initial vercel.app staging release. Never commit a filled copy.
NEXT_PUBLIC_API_URL=https://YOUR_API_PROJECT.vercel.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_DEVELOPMENT_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_ROTATED_MATCHING_CLERK_DEVELOPMENT_SECRET
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true
# No /api suffix in NEXT_PUBLIC_API_URL. Use keys from the same Clerk instance
# as backend CLERK_ISSUER_URL. Production Clerk requires a custom frontend domain.
