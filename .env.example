PINECONE_API_KEY=your_pinecone_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
DATABASE_URL=postgresql://user:password@host:5432/kio
# Local defaults. On Vercel use null and TRUSTED_PROXY_HOPS=1 (direct Vercel ingress).
DATABASE_POOL_MODE=default
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
GUEST_IP_HASH_SECRET=replace_with_a_random_32_byte_secret
TRUSTED_PROXY_HOPS=0
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
PINECONE_INDEX_NAME=medicalbot-v2
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
RETRIEVAL_K=6
RETRIEVAL_FETCH_K=16
RETRIEVAL_LAMBDA_MULT=0.65
RETRIEVAL_LEXICAL_K=4
RETRIEVAL_CONTEXT_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
ANSWER_MAX_TOKENS=1800
ANSWER_REVIEW_ENABLED=true
HISTORY_MESSAGE_LIMIT=12

# Optional read-only lexical artifact. Leave empty for local PDF/cache behavior.
# Vercel: backend/_artifacts/lexical-cache.json.gz
LEXICAL_CACHE_PATH=
# Vercel build only: private Blob URL, compressed file SHA256, private store token.
LEXICAL_CACHE_ARTIFACT_URL=
LEXICAL_CACHE_ARTIFACT_SHA256=
BLOB_READ_WRITE_TOKEN=
# Operator migration URL is supplied through DATABASE_URL for the migration command.
# Do not set a live database URL in repository files. See docs/vercel-deployment.md.
